				; DoSell : venta de un solo producto con descuento por cantidad.
				;   base      = precio * cantidad          (MUL, CF=1 si desborda)
				;   descuento = base*10/100 si cantidad>=10 (division entera: se descartan
				;               las fracciones de centavo); 0 en otro caso
				;   final     = base - descuento
				; Existencias e ingresos se modifican SOLO despues de pasar todas las pruebas.

 00000565			DoSell PROC
 00000565  E8 FFFFFD3C		    call AskProduct
 0000056A  0F 82 000000EC	    jc   sl_end
 00000570  E8 FFFFFCE4		    call ShowRecord
 00000575  E8 FFFFFD75		    call AskQuantity
 0000057A  0F 82 000000DC	    jc   sl_end
 00000580  8B D8		    mov  ebx, eax               ; EBX = cantidad
 00000582  3B 5E 28		    cmp  ebx, [esi+OFF_STOCK]
 00000585  0F 87 000000B8	    ja   sl_nostock
 0000058B  8B 46 24		    mov  eax, [esi+OFF_PRICE]
 0000058E  F7 E3		    mul  ebx                    ; EDX:EAX = precio*cantidad
 00000590  0F 82 000000BA	    jc   sl_ovf
 00000596  8B C8		    mov  ecx, eax               ; ECX = importe base
 00000598  33 FF		    xor  edi, edi               ; EDI = descuento
 0000059A  83 FB 0A		    cmp  ebx, DISC_MIN_QTY
 0000059D  72 18		    jb   sl_calc
 0000059F  8B C1		    mov  eax, ecx
 000005A1  BF 0000000A		    mov  edi, DISC_PCT
 000005A6  F7 E7		    mul  edi                    ; base*10
 000005A8  0F 82 000000A2	    jc   sl_ovf
 000005AE  BF 00000064		    mov  edi, 100
 000005B3  F7 F7		    div  edi                    ; EAX = base*10/100 (EDX=0 tras MUL sin acarreo)
 000005B5  8B F8		    mov  edi, eax               ; descuento (sin fraccion de centavo)
 000005B7			sl_calc:
 000005B7  8B D1		    mov  edx, ecx
 000005B9  2B D7		    sub  edx, edi               ; EDX = importe final
 000005BB  A1 00000600 R	    mov  eax, revenue
 000005C0  03 C2		    add  eax, edx               ; nuevos ingresos
 000005C2  0F 82 00000088	    jc   sl_ovf
				   ; ---- todo valido: se confirma la venta ----
 000005C8  A3 00000600 R	    mov  revenue, eax
 000005CD  8B 46 28		    mov  eax, [esi+OFF_STOCK]
 000005D0  2B C3		    sub  eax, ebx
 000005D2  89 46 28		    mov  [esi+OFF_STOCK], eax
 000005D5  C6 05 00000604 R	    mov  dirty, 1
	   01
				    Say  msgBase
 000005DC  52		     1	    push edx
 000005DD  BA 000012FF R     1	    mov  edx, OFFSET msgBase
 000005E2  E8 00000000 E     1	    call WriteString
 000005E7  5A		     1	    pop  edx
 000005E8  8B C1		    mov  eax, ecx
 000005EA  E8 FFFFFB75		    call PrintMXN
 000005EF  E8 00000000 E	    call Crlf
 000005F4  85 FF		    test edi, edi
 000005F6  74 1A		    jz   sl_nodisc
				    Say  msgDisc
 000005F8  52		     1	    push edx
 000005F9  BA 0000130F R     1	    mov  edx, OFFSET msgDisc
 000005FE  E8 00000000 E     1	    call WriteString
 00000603  5A		     1	    pop  edx
 00000604  8B C7		    mov  eax, edi
 00000606  E8 FFFFFB59		    call PrintMXN
 0000060B  E8 00000000 E	    call Crlf
 00000610  EB 0C		    jmp  sl_final
 00000612			sl_nodisc:
				    Say  msgNoDisc
 00000612  52		     1	    push edx
 00000613  BA 00001338 R     1	    mov  edx, OFFSET msgNoDisc
 00000618  E8 00000000 E     1	    call WriteString
 0000061D  5A		     1	    pop  edx
 0000061E			sl_final:
				    Say  msgFinal
 0000061E  52		     1	    push edx
 0000061F  BA 00001360 R     1	    mov  edx, OFFSET msgFinal
 00000624  E8 00000000 E     1	    call WriteString
 00000629  5A		     1	    pop  edx
 0000062A  8B C2		    mov  eax, edx
 0000062C  E8 FFFFFB33		    call PrintMXN
 00000631  E8 00000000 E	    call Crlf
				    Say  msgSaleOk
 00000636  52		     1	    push edx
 00000637  BA 00001370 R     1	    mov  edx, OFFSET msgSaleOk
 0000063C  E8 00000000 E     1	    call WriteString
 00000641  5A		     1	    pop  edx
 00000642  C3			    ret
 00000643			sl_nostock:
				    Say  msgNoStock
 00000643  52		     1	    push edx
 00000644  BA 000012A0 R     1	    mov  edx, OFFSET msgNoStock
 00000649  E8 00000000 E     1	    call WriteString
 0000064E  5A		     1	    pop  edx
 0000064F  C3			    ret
 00000650			sl_ovf:
				    Say  msgOvf
 00000650  52		     1	    push edx
 00000651  BA 000012CE R     1	    mov  edx, OFFSET msgOvf
 00000656  E8 00000000 E     1	    call WriteString
 0000065B  5A		     1	    pop  edx
 0000065C			sl_end:
 0000065C  C3			    ret
 0000065D			DoSell ENDP

				; DoSummary : unidades, valor del inventario e ingresos de la sesion.
