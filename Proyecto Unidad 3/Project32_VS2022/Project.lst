				    Say  msgSumRev
 000006B4  52		     1	    push edx
 000006B5  BA 000013B2 R     1	    mov  edx, OFFSET msgSumRev
 000006BA  E8 00000000 E     1	    call WriteString
 000006BF  5A		     1	    pop  edx
 000006C0  A1 00000600 R	    mov  eax, revenue
 000006C5  E8 FFFFFA9A		    call PrintMXN
 000006CA  E8 00000000 E	    call Crlf
 000006CF  C3			    ret
 000006D0			sm_ovf:
				    Say  msgOvf
 000006D0  52		     1	    push edx
 000006D1  BA 000012CE R     1	    mov  edx, OFFSET msgOvf
 000006D6  E8 00000000 E     1	    call WriteString
 000006DB  5A		     1	    pop  edx
 000006DC  C3			    ret
 000006DD			DoSummary ENDP

				; AppendStr : agrega una cadena (sin el 00h) al buffer de salida.
				; Entrada : EDX = cadena origen, EDI = destino.
				; Salida  : EDI avanza al final del texto copiado.
				; Modifica: EDI, EFLAGS

 000006DD			AppendStr PROC
 000006DD  50			    push eax
 000006DE  52			    push edx
 000006DF			as_loop:
 000006DF  8A 02		    mov  al, [edx]
 000006E1  84 C0		    test al, al
 000006E3  74 06		    jz   as_done
 000006E5  88 07		    mov  [edi], al
 000006E7  42			    inc  edx
 000006E8  47			    inc  edi
 000006E9  EB F4		    jmp  as_loop
 000006EB			as_done:
 000006EB  5A			    pop  edx
 000006EC  58			    pop  eax
 000006ED  C3			    ret
 000006EE			AppendStr ENDP

				; ToDecStr : entero sin signo -> cadena decimal en numbuf (cociente/residuo).
				; Entrada : EAX = valor.
				; Salida  : EDX = inicio de la cadena (terminada en 00h).
				; Modifica: EDX, EFLAGS

 000006EE			ToDecStr PROC
 000006EE  50			    push eax
 000006EF  53			    push ebx
 000006F0  51			    push ecx
 000006F1  B9 000006BE R	    mov  ecx, OFFSET numbuf + 11
 000006F6  C6 01 00		    mov  BYTE PTR [ecx], 0
 000006F9  BB 0000000A		    mov  ebx, 10
 000006FE			td_loop:
 000006FE  33 D2		    xor  edx, edx
 00000700  F7 F3		    div  ebx                    ; EAX = cociente, EDX = residuo
 00000702  80 C2 30		    add  dl, '0'
 00000705  49			    dec  ecx
 00000706  88 11		    mov  [ecx], dl
 00000708  85 C0		    test eax, eax
 0000070A  75 F2		    jnz  td_loop
 0000070C  8B D1		    mov  edx, ecx
 0000070E  59			    pop  ecx
 0000070F  5B			    pop  ebx
 00000710  58			    pop  eax
 00000711  C3			    ret
 00000712			ToDecStr ENDP

				; AppendU32 : agrega EAX en decimal al buffer de salida.
				; Entrada : EAX = valor, EDI = destino.   Salida: EDI avanza.
				; Modifica: EDI, EFLAGS

 00000712			AppendU32 PROC
 00000712  52			    push edx
 00000713  E8 FFFFFFD6		    call ToDecStr
 00000718  E8 FFFFFFC0		    call AppendStr
 0000071D  5A			    pop  edx
 0000071E  C3			    ret
 0000071F			AppendU32 ENDP

				; AppendMXN : agrega centavos como pesos con 2 decimales ("45.50", "5.05").
				; Entrada : EAX = centavos, EDI = destino.   Salida: EDI avanza.
				; Modifica: EDI, EFLAGS

 0000071F			AppendMXN PROC
 0000071F  50			    push eax
 00000720  53			    push ebx
 00000721  52			    push edx
 00000722  BB 00000064		    mov  ebx, 100
 00000727  33 D2		    xor  edx, edx
 00000729  F7 F3		    div  ebx                    ; EAX = pesos, EDX = centavos
 0000072B  52			    push edx
 0000072C  E8 FFFFFFE1		    call AppendU32
 00000731  BA 0000156E R	    mov  edx, OFFSET msgDot
 00000736  E8 FFFFFFA2		    call AppendStr
 0000073B  58			    pop  eax                    ; centavos
 0000073C  83 F8 0A		    cmp  eax, 10
 0000073F  73 0A		    jae  am_two
 00000741  BA 00001570 R	    mov  edx, OFFSET msgZero    ; residuo < 10 -> "0" + digito
 00000746  E8 FFFFFF92		    call AppendStr
 0000074B			am_two:
 0000074B  E8 FFFFFFC2		    call AppendU32
 00000750  5A			    pop  edx
 00000751  5B			    pop  ebx
 00000752  58			    pop  eax
 00000753  C3			    ret
 00000754			AppendMXN ENDP

				; SaveCatalog : arma el texto en outbuf (recorriendo la tabla con ESI) y lo
				;               escribe en inventario.dat.
				; Salida  : CF=1 si fallo (CreateOutputFile, WriteToFile o CloseFile).
				; Modifica: EAX, ECX, EDX, ESI, EDI, EFLAGS

 00000754			SaveCatalog PROC
 00000754  BF 0000039C R	    mov  edi, OFFSET outbuf
 00000759  BA 000005F4 R	    mov  edx, OFFSET txtHeader
 0000075E  E8 FFFFFF7A		    call AppendStr
 00000763  BE 00000004 R	    mov  esi, OFFSET products
 00000768  8B 0D 00000000 R	    mov  ecx, prodCount
 0000076E  85 C9		    test ecx, ecx
 00000770  74 4D		    jz   sv_write
 00000772			sv_loop:
 00000772  8B D6		    mov  edx, esi               ; codigo
 00000774  E8 FFFFFF64		    call AppendStr
 00000779  BA 000005FB R	    mov  edx, OFFSET txtSemi
 0000077E  E8 FFFFFF5A		    call AppendStr
 00000783  8D 56 08		    lea  edx, [esi+OFF_NAME]    ; nombre
 00000786  E8 FFFFFF52		    call AppendStr
 0000078B  BA 000005FB R	    mov  edx, OFFSET txtSemi
 00000790  E8 FFFFFF48		    call AppendStr
 00000795  8B 46 24		    mov  eax, [esi+OFF_PRICE]   ; precio 45.50
 00000798  E8 FFFFFF82		    call AppendMXN
 0000079D  BA 000005FB R	    mov  edx, OFFSET txtSemi
 000007A2  E8 FFFFFF36		    call AppendStr
 000007A7  8B 46 28		    mov  eax, [esi+OFF_STOCK]   ; existencia
 000007AA  E8 FFFFFF63		    call AppendU32
 000007AF  BA 000005FD R	    mov  edx, OFFSET txtCRLF
 000007B4  E8 FFFFFF24		    call AppendStr
 000007B9  83 C6 2C		    add  esi, REC_SIZE
 000007BC  49			    dec  ecx
 000007BD  75 B3		    jnz  sv_loop
 000007BF			sv_write:
 000007BF  8B C7		    mov  eax, edi
 000007C1  2D 0000039C R	    sub  eax, OFFSET outbuf     ; bytes a escribir
 000007C6  A3 000006D2 R	    mov  expected, eax
 000007CB  BA 000006BF R	    mov  edx, OFFSET fileName
 000007D0  E8 00000000 E	    call CreateOutputFile       ; EAX = handle o INVALID_HANDLE_VALUE
 000007D5  83 F8 FF		    cmp  eax, INVALID_HANDLE_VALUE
 000007D8  74 44		    je   sv_err
 000007DA  A3 000006CE R	    mov  hFile, eax
 000007DF  BA 0000039C R	    mov  edx, OFFSET outbuf
 000007E4  8B 0D 000006D2 R	    mov  ecx, expected
 000007EA  E8 00000000 E	    call WriteToFile            ; EAX = bytes escritos
 000007EF  50			    push eax
 000007F0  A1 000006CE R	    mov  eax, hFile
 000007F5  E8 00000000 E	    call CloseFile              ; EAX<>0 si cierra bien
 000007FA  8B C8		    mov  ecx, eax
 000007FC  58			    pop  eax
 000007FD  3B 05 000006D2 R	    cmp  eax, expected          ; se escribieron todos los bytes?
 00000803  75 19		    jne  sv_err
 00000805  85 C9		    test ecx, ecx
 00000807  74 15		    jz   sv_err
 00000809  C6 05 00000604 R	    mov  dirty, 0
	   00
				    Say  msgSaved
 00000810  52		     1	    push edx
 00000811  BA 000013CA R     1	    mov  edx, OFFSET msgSaved
 00000816  E8 00000000 E     1	    call WriteString
 0000081B  5A		     1	    pop  edx
 0000081C  F8			    clc
 0000081D  C3			    ret
 0000081E			sv_err:
				    Say  msgSaveErr
 0000081E  52		     1	    push edx
 0000081F  BA 000013F1 R     1	    mov  edx, OFFSET msgSaveErr
 00000824  E8 00000000 E     1	    call WriteString
 00000829  5A		     1	    pop  edx
 0000082A  F9			    stc
 0000082B  C3			    ret
 0000082C			SaveCatalog ENDP

				; ReadField : copia a fieldbuf los caracteres del texto hasta ';', CR, LF o 00h.
				; Entrada : EBX = posicion en el texto, ECX = maximo de caracteres.
				; Salida  : EBX apunta al terminador, AL = terminador, fieldbuf = campo + 00h.
				;           CF=1 si el campo excede ECX caracteres.

 0000082C			ReadField PROC
 0000082C  51			    push ecx
 0000082D  57			    push edi
 0000082E  BF 0000037C R	    mov  edi, OFFSET fieldbuf
 00000833			rf_loop:
 00000833  8A 03		    mov  al, [ebx]
 00000835  3C 3B		    cmp  al, ';'
 00000837  74 17		    je   rf_end
 00000839  84 C0		    test al, al
 0000083B  74 13		    jz   rf_end
 0000083D  3C 0D		    cmp  al, 13
 0000083F  74 0F		    je   rf_end
 00000841  3C 0A		    cmp  al, 10
 00000843  74 0B		    je   rf_end
 00000845  85 C9		    test ecx, ecx
 00000847  74 0D		    jz   rf_bad
 00000849  88 07		    mov  [edi], al
 0000084B  47			    inc  edi
 0000084C  43			    inc  ebx
 0000084D  49			    dec  ecx
 0000084E  EB E3		    jmp  rf_loop
 00000850			rf_end:
 00000850  C6 07 00		    mov  BYTE PTR [edi], 0
 00000853  F8			    clc
 00000854  EB 01		    jmp  rf_done
 00000856			rf_bad:
 00000856  F9			    stc
 00000857			rf_done:
 00000857  5F			    pop  edi
 00000858  59			    pop  ecx
 00000859  C3			    ret
 0000085A			ReadField ENDP

				; LoadCatalog : lee inventario.dat a loadbuf, interpreta el texto y lo valida
				;               en tmpTable. Solo si TODO es valido reemplaza el catalogo.
				; Validaciones: archivo existe, lectura sin error, tamano < capacidad, linea
				;   "INV1", maximo 10 lineas, cada campo (codigo, nombre, precio, existencia)
