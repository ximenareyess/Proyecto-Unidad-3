 00000000			.code

				; CopyPad : copia una cadena a un campo de tamano fijo y rellena con 0.
				; Entrada : ESI = origen (cadena terminada en 0), EDI = destino, ECX = tamano
				;           del campo (incluye el 0 final).
				; Salida  : campo con a lo mas ECX-1 caracteres + ceros.

 00000000			CopyPad PROC
 00000000  50			    push eax
 00000001  51			    push ecx
 00000002  56			    push esi
 00000003  57			    push edi
 00000004  49			    dec  ecx                    ; reserva el byte del terminador
 00000005			cp_loop:
 00000005  85 C9		    test ecx, ecx
 00000007  74 0D		    jz   cp_fin
 00000009  8A 06		    mov  al, [esi]
 0000000B  84 C0		    test al, al
 0000000D  74 07		    jz   cp_fin
 0000000F  88 07		    mov  [edi], al
 00000011  46			    inc  esi
 00000012  47			    inc  edi
 00000013  49			    dec  ecx
 00000014  EB EF		    jmp  cp_loop
 00000016			cp_fin:
 00000016  41			    inc  ecx                    ; bytes restantes (>=1) a poner en cero
 00000017			cp_zero:
 00000017  C6 07 00		    mov  BYTE PTR [edi], 0
 0000001A  47			    inc  edi
 0000001B  49			    dec  ecx
 0000001C  75 F9		    jnz  cp_zero
 0000001E  5F			    pop  edi
 0000001F  5E			    pop  esi
 00000020  59			    pop  ecx
 00000021  58			    pop  eax
 00000022  C3			    ret
 00000023			CopyPad ENDP


				; ReadLine : captura una linea en inbuf con ReadString.
				; Entrada : (ninguna) EDX=OFFSET inbuf y ECX=INBUF_MAX se preparan aqui.
				; Salida  : EAX = caracteres leidos; CF=1 si la linea era demasiado larga
				;           (el resto se descarta leyendo hasta vaciar la linea).

 00000023			ReadLine PROC
 00000023  52			    push edx
 00000024  51			    push ecx
 00000025  BA 00000609 R	    mov  edx, OFFSET inbuf
 0000002A  B9 0000003F		    mov  ecx, INBUF_MAX         ; max de caracteres (buffer = ECX+1 bytes)
 0000002F  E8 00000000 E	    call ReadString             ; EAX = numero de caracteres capturados
 00000034  83 F8 3F		    cmp  eax, INBUF_MAX
 00000037  72 1C		    jb   rl_ok
 00000039			rl_drain:
 00000039  BA 00000649 R	    mov  edx, OFFSET junkbuf
 0000003E  B9 0000003F		    mov  ecx, INBUF_MAX
 00000043  E8 00000000 E	    call ReadString
 00000048  83 F8 3F		    cmp  eax, INBUF_MAX
 0000004B  73 EC		    jae  rl_drain
 0000004D  B8 0000003F		    mov  eax, INBUF_MAX
 00000052  F9			    stc
 00000053  EB 01		    jmp  rl_done
 00000055			rl_ok:
 00000055  F8			    clc
 00000056			rl_done:
 00000056  59			    pop  ecx
 00000057  5A			    pop  edx
 00000058  C3			    ret
 00000059			ReadLine ENDP


				; GetInput : ReadLine + rechazo de entrada vacia o demasiado larga.
				; Salida  : EAX = longitud; CF=1 si hay error (ya muestra el mensaje).
				; Modifica: EAX, EFLAGS

 00000059			GetInput PROC
 00000059  E8 FFFFFFC5		    call ReadLine
 0000005E  72 04		    jc   gi_bad
 00000060  85 C0		    test eax, eax
 00000062  75 0E		    jnz  gi_ok
 00000064			gi_bad:
				    Say  msgBadInput
 00000064  52		     1	    push edx
 00000065  BA 00000FDE R     1	    mov  edx, OFFSET msgBadInput
 0000006A  E8 00000000 E     1	    call WriteString
 0000006F  5A		     1	    pop  edx
 00000070  F9			    stc
 00000071  C3			    ret
 00000072			gi_ok:
 00000072  F8			    clc
 00000073  C3			    ret
 00000074			GetInput ENDP


				; ParseUInt : cadena de digitos -> entero sin signo (solo '0'..'9').
				; Entrada : ESI = cadena terminada en 0.
				; Salida  : EAX = valor; CF=1 si vacia, con caracteres no permitidos o si
				;           desborda 32 bits.

 00000074			ParseUInt PROC
 00000074  53			    push ebx
 00000075  51			    push ecx
 00000076  52			    push edx
 00000077  56			    push esi
 00000078  33 C0		    xor  eax, eax
 0000007A  33 C9		    xor  ecx, ecx               ; contador de digitos
 0000007C			pu_loop:
 0000007C  0F B6 1E		    movzx ebx, BYTE PTR [esi]
 0000007F  84 DB		    test bl, bl
 00000081  74 1E		    jz   pu_end
 00000083  80 FB 30		    cmp  bl, '0'
 00000086  72 20		    jb   pu_bad
 00000088  80 FB 39		    cmp  bl, '9'
 0000008B  77 1B		    ja   pu_bad
 0000008D  83 EB 30		    sub  ebx, '0'
 00000090  BA 0000000A		    mov  edx, 10
 00000095  F7 E2		    mul  edx                    ; EDX:EAX = EAX*10 ; CF=1 si EDX<>0
 00000097  72 0F		    jc   pu_bad
 00000099  03 C3		    add  eax, ebx
 0000009B  72 0B		    jc   pu_bad
 0000009D  46			    inc  esi
 0000009E  41			    inc  ecx
 0000009F  EB DB		    jmp  pu_loop
 000000A1			pu_end:
 000000A1  85 C9		    test ecx, ecx
 000000A3  74 03		    jz   pu_bad
 000000A5  F8			    clc
 000000A6  EB 01		    jmp  pu_done
 000000A8			pu_bad:
 000000A8  F9			    stc
 000000A9			pu_done:
 000000A9  5E			    pop  esi
 000000AA  5A			    pop  edx
 000000AB  59			    pop  ecx
 000000AC  5B			    pop  ebx
 000000AD  C3			    ret
 000000AE			ParseUInt ENDP

				; ParsePrice : "185.50" -> 18550 centavos. Acepta enteros o punto con 1 o 2
				;              decimales. Rechaza simbolos, separadores de miles, ".5", "5.",
				;              tercer decimal y fuera de rango (1..999999 centavos).
				; Entrada : ESI = cadena terminada en 0.
				; Salida  : EAX = centavos; CF=1 si es invalida.

 000000AE			ParsePrice PROC
 000000AE  53			    push ebx
 000000AF  51			    push ecx
 000000B0  52			    push edx
 000000B1  56			    push esi
 000000B2  33 C0		    xor  eax, eax               ; pesos
 000000B4  33 C9		    xor  ecx, ecx               ; digitos enteros
 000000B6			pp_int:
 000000B6  0F B6 16		    movzx edx, BYTE PTR [esi]
 000000B9  84 D2		    test dl, dl
 000000BB  74 22		    jz   pp_intEnd
 000000BD  80 FA 2E		    cmp  dl, '.'
 000000C0  74 1D		    je   pp_intEnd
 000000C2  80 FA 30		    cmp  dl, '0'
 000000C5  72 6A		    jb   pp_bad
 000000C7  80 FA 39		    cmp  dl, '9'
 000000CA  77 65		    ja   pp_bad
 000000CC  83 EA 30		    sub  edx, '0'
 000000CF  6B C0 0A		    imul eax, eax, 10
 000000D2  03 C2		    add  eax, edx
 000000D4  3D 0000270F		    cmp  eax, 9999              ; evita desbordar y valida el maximo de pesos
 000000D9  77 56		    ja   pp_bad
 000000DB  46			    inc  esi
 000000DC  41			    inc  ecx
 000000DD  EB D7		    jmp  pp_int
 000000DF			pp_intEnd:
 000000DF  85 C9		    test ecx, ecx               ; al menos un digito antes del punto
 000000E1  74 4E		    jz   pp_bad
 000000E3  6B D8 64		    imul ebx, eax, 100          ; EBX = pesos*100
 000000E6  80 3E 00		    cmp  BYTE PTR [esi], 0
 000000E9  74 34		    je   pp_range               ; sin parte decimal
 000000EB  46			    inc  esi                    ; salta el '.'
 000000EC  0F B6 16		    movzx edx, BYTE PTR [esi]   ; primer decimal (obligatorio)
 000000EF  80 FA 30		    cmp  dl, '0'
 000000F2  72 3D		    jb   pp_bad
 000000F4  80 FA 39		    cmp  dl, '9'
 000000F7  77 38		    ja   pp_bad
 000000F9  83 EA 30		    sub  edx, '0'
 000000FC  6B D2 0A		    imul edx, edx, 10           ; decenas de centavo
 000000FF  03 DA		    add  ebx, edx
 00000101  46			    inc  esi
 00000102  80 3E 00		    cmp  BYTE PTR [esi], 0
 00000105  74 18		    je   pp_range               ; un solo decimal: 185.5 -> 18550
 00000107  0F B6 16		    movzx edx, BYTE PTR [esi]   ; segundo decimal
 0000010A  80 FA 30		    cmp  dl, '0'
 0000010D  72 22		    jb   pp_bad
 0000010F  80 FA 39		    cmp  dl, '9'
 00000112  77 1D		    ja   pp_bad
 00000114  83 EA 30		    sub  edx, '0'
 00000117  03 DA		    add  ebx, edx
 00000119  46			    inc  esi
 0000011A  80 3E 00		    cmp  BYTE PTR [esi], 0      ; un tercer caracter => rechazo
 0000011D  75 12		    jne  pp_bad
 0000011F			pp_range:
 0000011F  83 FB 01		    cmp  ebx, 1
 00000122  72 0D		    jb   pp_bad
 00000124  81 FB 000F423F	    cmp  ebx, MAX_PRICE
 0000012A  77 05		    ja   pp_bad
 0000012C  8B C3		    mov  eax, ebx
 0000012E  F8			    clc
 0000012F  EB 01		    jmp  pp_done
 00000131			pp_bad:
 00000131  F9			    stc
 00000132			pp_done:
 00000132  5E			    pop  esi
 00000133  5A			    pop  edx
 00000134  59			    pop  ecx
 00000135  5B			    pop  ebx
 00000136  C3			    ret
 00000137			ParsePrice ENDP


				; PrintU32 : muestra EAX como decimal sin signo (division entre 10).
				;            Los digitos salen en orden inverso (residuos), por eso se
				;            escriben desde el final del buffer hacia atras.
				; Entrada : EAX = valor.
				; Salida  : texto en consola.

 00000137			PrintU32 PROC
 00000137  50			    push eax
 00000138  53			    push ebx
 00000139  51			    push ecx
 0000013A  52			    push edx
 0000013B  57			    push edi
 0000013C  BF 000006BE R	    mov  edi, OFFSET numbuf + 11
 00000141  C6 07 00		    mov  BYTE PTR [edi], 0      ; terminador 00h
 00000144  BB 0000000A		    mov  ebx, 10
 00000149			pu32_loop:
 00000149  33 D2		    xor  edx, edx               ; dividendo = EDX:EAX
 0000014B  F7 F3		    div  ebx                    ; EAX = cociente, EDX = residuo (0..9)
 0000014D  80 C2 30		    add  dl, '0'                ; digito.. ASCII
 00000150  4F			    dec  edi
 00000151  88 17		    mov  [edi], dl
 00000153  85 C0		    test eax, eax
 00000155  75 F2		    jnz  pu32_loop
 00000157  8B D7		    mov  edx, edi
 00000159  E8 00000000 E	    call WriteString
 0000015E  5F			    pop  edi
 0000015F  5A			    pop  edx
 00000160  59			    pop  ecx
 00000161  5B			    pop  ebx
 00000162  58			    pop  eax
 00000163  C3			    ret
 00000164			PrintU32 ENDP


				; PrintMXN : muestra centavos como "$ 1234.05 MXN".
				; Entrada : EAX = centavos.
				; Salida  : texto en consola.

 00000164			PrintMXN PROC
 00000164  50			    push eax
 00000165  53			    push ebx
 00000166  52			    push edx
				    Say  msgDollar
 00000167  52		     1	    push edx
 00000168  BA 0000156C R     1	    mov  edx, OFFSET msgDollar
 0000016D  E8 00000000 E     1	    call WriteString
 00000172  5A		     1	    pop  edx
 00000173  BB 00000064		    mov  ebx, 100
 00000178  33 D2		    xor  edx, edx
 0000017A  F7 F3		    div  ebx                    ; EAX = pesos, EDX = centavos (0..99)
 0000017C  52			    push edx                    ; guarda centavos
 0000017D  E8 FFFFFFB5		    call PrintU32               ; pesos
				    Say  msgDot
 00000182  52		     1	    push edx
 00000183  BA 0000156E R     1	    mov  edx, OFFSET msgDot
 00000188  E8 00000000 E     1	    call WriteString
 0000018D  5A		     1	    pop  edx
 0000018E  58			    pop  eax                    ; centavos
 0000018F  83 F8 0A		    cmp  eax, 10
 00000192  73 0C		    jae  pm_two
				    Say  msgZero                ; residuo 5 -> "05"
 00000194  52		     1	    push edx
 00000195  BA 00001570 R     1	    mov  edx, OFFSET msgZero
 0000019A  E8 00000000 E     1	    call WriteString
 0000019F  5A		     1	    pop  edx
 000001A0			pm_two:
 000001A0  E8 FFFFFF92		    call PrintU32
				    Say  msgMXN
 000001A5  52		     1	    push edx
 000001A6  BA 00001572 R     1	    mov  edx, OFFSET msgMXN
 000001AB  E8 00000000 E     1	    call WriteString
 000001B0  5A		     1	    pop  edx
 000001B1  5A			    pop  edx
 000001B2  5B			    pop  ebx
 000001B3  58			    pop  eax
 000001B4  C3			    ret
 000001B5			PrintMXN ENDP


				; ValidateCode : valida ABC-123 (3 mayusculas, guion, 3 digitos, fin de cadena)
				; Entrada : ESI = cadena.
				; Salida  : CF=1 si es invalida.
				; (ESI se conserva)

 000001B5			ValidateCode PROC
 000001B5  50			    push eax
 000001B6  51			    push ecx
 000001B7  56			    push esi
 000001B8  B9 00000003		    mov  ecx, 3
 000001BD			vc_l1:
 000001BD  8A 06		    mov  al, [esi]
 000001BF  3C 41		    cmp  al, 'A'
 000001C1  72 28		    jb   vc_bad
 000001C3  3C 5A		    cmp  al, 'Z'
 000001C5  77 24		    ja   vc_bad
 000001C7  46			    inc  esi
 000001C8  E2 F3		    loop vc_l1
 000001CA  8A 06		    mov  al, [esi]
 000001CC  3C 2D		    cmp  al, '-'
 000001CE  75 1B		    jne  vc_bad
 000001D0  46			    inc  esi
 000001D1  B9 00000003		    mov  ecx, 3
 000001D6			vc_l2:
 000001D6  8A 06		    mov  al, [esi]
 000001D8  3C 30		    cmp  al, '0'
 000001DA  72 0F		    jb   vc_bad
 000001DC  3C 39		    cmp  al, '9'
 000001DE  77 0B		    ja   vc_bad
 000001E0  46			    inc  esi
 000001E1  E2 F3		    loop vc_l2
 000001E3  80 3E 00		    cmp  BYTE PTR [esi], 0
 000001E6  75 03		    jne  vc_bad
 000001E8  F8			    clc
 000001E9  EB 01		    jmp  vc_done
 000001EB			vc_bad:
 000001EB  F9			    stc
 000001EC			vc_done:
 000001EC  5E			    pop  esi
 000001ED  59			    pop  ecx
 000001EE  58			    pop  eax
 000001EF  C3			    ret
 000001F0			ValidateCode ENDP


				; ValidateName : 1 a 25 caracteres ASCII imprimibles y terminador 0.
				; Entrada : ESI = cadena.
				; Salida  : CF=1 si es invalida.
				;  EFLAGS (ESI se conserva)

 000001F0			ValidateName PROC
 000001F0  50			    push eax
 000001F1  51			    push ecx
 000001F2  56			    push esi
 000001F3  33 C9		    xor  ecx, ecx
 000001F5			vn_loop:
 000001F5  8A 06		    mov  al, [esi]
 000001F7  84 C0		    test al, al
 000001F9  74 15		    jz   vn_end
 000001FB  3C 20		    cmp  al, 32
 000001FD  72 18		    jb   vn_bad
 000001FF  3C 7E		    cmp  al, 126
 00000201  77 14		    ja   vn_bad
 00000203  3C 3B		    cmp  al, ';'                ; separador del archivo
 00000205  74 10		    je   vn_bad
 00000207  46			    inc  esi
 00000208  41			    inc  ecx
 00000209  83 F9 19		    cmp  ecx, 25
 0000020C  76 E7		    jbe  vn_loop
 0000020E  EB 07		    jmp  vn_bad                 ; mas de 25 caracteres
 00000210			vn_end:
 00000210  85 C9		    test ecx, ecx
 00000212  74 03		    jz   vn_bad                 ; vacio
 00000214  F8			    clc
 00000215  EB 01		    jmp  vn_done
 00000217			vn_bad:
 00000217  F9			    stc
 00000218			vn_done:
 00000218  5E			    pop  esi
 00000219  59			    pop  ecx
 0000021A  58			    pop  eax
 0000021B  C3			    ret
 0000021C			ValidateName ENDP

				; CodesEqual : compara los 7 caracteres de dos codigos.
				; Entrada : ESI, EDI = codigos.
				; Salida  : ZF=1 si son iguales.


 0000021C			CodesEqual PROC
 0000021C  50			    push eax
 0000021D  51			    push ecx
 0000021E  56			    push esi
 0000021F  57			    push edi
 00000220  B9 00000007		    mov  ecx, 7
 00000225			ce_loop:
 00000225  8A 06		    mov  al, [esi]
 00000227  3A 07		    cmp  al, [edi]
 00000229  75 06		    jne  ce_done                ; ZF=0
 0000022B  46			    inc  esi
 0000022C  47			    inc  edi
 0000022D  E2 F6		    loop ce_loop
 0000022F  33 C0		    xor  eax, eax               ; llegaron los 7 iguales: fuerza ZF=1
 00000231			ce_done:
 00000231  5F			    pop  edi                    ; POP no altera las banderas
 00000232  5E			    pop  esi
 00000233  59			    pop  ecx
 00000234  58			    pop  eax
 00000235  C3			    ret
 00000236			CodesEqual ENDP


				; FindProduct : busca un codigo en el catalogo (recorrido con ESI).
				; Entrada : EDI = codigo (cadena).
				; Salida  : CF=0 y ESI = registro encontrado; CF=1 si no existe.
				; Modifica: ESI, EFLAGS


 00000236			FindProduct PROC
 00000236  51			    push ecx
 00000237  BE 00000004 R	    mov  esi, OFFSET products
 0000023C  8B 0D 00000000 R	    mov  ecx, prodCount
 00000242  85 C9		    test ecx, ecx
 00000244  74 0D		    jz   fp_nf
 00000246			fp_loop:
 00000246  E8 FFFFFFD1		    call CodesEqual
 0000024B  74 09		    je   fp_found
 0000024D  83 C6 2C		    add  esi, REC_SIZE
 00000250  49			    dec  ecx
 00000251  75 F3		    jnz  fp_loop
 00000253			fp_nf:
 00000253  F9			    stc
 00000254  59			    pop  ecx
 00000255  C3			    ret
 00000256			fp_found:
 00000256  F8			    clc
 00000257  59			    pop  ecx
 00000258  C3			    ret
 00000259			FindProduct ENDP

				; ShowRecord : imprime un producto.
				; Entrada : ESI = registro.
				; Modifica: EFLAGS

 00000259			ShowRecord PROC
 00000259  50			    push eax
 0000025A  52			    push edx
 0000025B  8B D6		    mov  edx, esi               ; codigo (offset 0)
 0000025D  E8 00000000 E	    call WriteString
				    Say  msgSep
 00000262  52		     1	    push edx
 00000263  BA 00001558 R     1	    mov  edx, OFFSET msgSep
 00000268  E8 00000000 E     1	    call WriteString
 0000026D  5A		     1	    pop  edx
 0000026E  8D 56 08		    lea  edx, [esi+OFF_NAME]
 00000271  E8 00000000 E	    call WriteString
				    Say  msgSep
 00000276  52		     1	    push edx
 00000277  BA 00001558 R     1	    mov  edx, OFFSET msgSep
 0000027C  E8 00000000 E     1	    call WriteString
 00000281  5A		     1	    pop  edx
 00000282  8B 46 24		    mov  eax, [esi+OFF_PRICE]
 00000285  E8 FFFFFEDA		    call PrintMXN
				    Say  msgExist
 0000028A  52		     1	    push edx
 0000028B  BA 0000155C R     1	    mov  edx, OFFSET msgExist
 00000290  E8 00000000 E     1	    call WriteString
 00000295  5A		     1	    pop  edx
 00000296  8B 46 28		    mov  eax, [esi+OFF_STOCK]
 00000299  E8 FFFFFE99		    call PrintU32
 0000029E  E8 00000000 E	    call Crlf
 000002A3  5A			    pop  edx
 000002A4  58			    pop  eax
 000002A5  C3			    ret
 000002A6			ShowRecord ENDP

				; AskProduct : pide un codigo, lo valida y lo localiza.
				; Salida  : CF=0 y ESI = registro; CF=1 si hubo error (mensaje ya mostrado).
				; Modifica: ESI, EDI, EAX, EFLAGS

 000002A6			AskProduct PROC
				    Say  msgAskCode
 000002A6  52		     1	    push edx
 000002A7  BA 00001016 R     1	    mov  edx, OFFSET msgAskCode
 000002AC  E8 00000000 E     1	    call WriteString
 000002B1  5A		     1	    pop  edx
 000002B2  E8 FFFFFDA2		    call GetInput
 000002B7  72 34		    jc   ap_err
 000002B9  BE 00000609 R	    mov  esi, OFFSET inbuf
 000002BE  E8 FFFFFEF2		    call ValidateCode
 000002C3  72 0E		    jc   ap_badfmt
 000002C5  BF 00000609 R	    mov  edi, OFFSET inbuf
 000002CA  E8 FFFFFF67		    call FindProduct
 000002CF  72 10		    jc   ap_nf
 000002D1  F8			    clc
 000002D2  C3			    ret
 000002D3			ap_badfmt:
				    Say  msgBadCode
 000002D3  52		     1	    push edx
 000002D4  BA 00001097 R     1	    mov  edx, OFFSET msgBadCode
 000002D9  E8 00000000 E     1	    call WriteString
 000002DE  5A		     1	    pop  edx
 000002DF  F9			    stc
 000002E0  C3			    ret
 000002E1			ap_nf:
				    Say  msgNotFound
 000002E1  52		     1	    push edx
 000002E2  BA 000010FA R     1	    mov  edx, OFFSET msgNotFound
 000002E7  E8 00000000 E     1	    call WriteString
 000002EC  5A		     1	    pop  edx
 000002ED			ap_err:
 000002ED  F9			    stc
 000002EE  C3			    ret
 000002EF			AskProduct ENDP


				; AskQuantity : pide una cantidad entera 1..100.
				; Salida  : EAX = cantidad; CF=1 si es invalida (mensaje ya mostrado).
				; Modifica: EAX, EFLAGS (ESI se conserva)

 000002EF			AskQuantity PROC
 000002EF  56			    push esi
				    Say  msgAskQty
 000002F0  52		     1	    push edx
 000002F1  BA 00001082 R     1	    mov  edx, OFFSET msgAskQty
 000002F6  E8 00000000 E     1	    call WriteString
 000002FB  5A		     1	    pop  edx
 000002FC  E8 FFFFFD58		    call GetInput
 00000301  72 24		    jc   aq_err
 00000303  BE 00000609 R	    mov  esi, OFFSET inbuf
 00000308  E8 FFFFFD67		    call ParseUInt
 0000030D  72 0C		    jc   aq_inv
 0000030F  85 C0		    test eax, eax
 00000311  74 08		    jz   aq_inv
 00000313  83 F8 64		    cmp  eax, MAX_STOCK
 00000316  77 03		    ja   aq_inv
 00000318  F8			    clc
 00000319  EB 0D		    jmp  aq_done
 0000031B			aq_inv:
				    Say  msgBadQty
 0000031B  52		     1	    push edx
 0000031C  BA 000011AF R     1	    mov  edx, OFFSET msgBadQty
 00000321  E8 00000000 E     1	    call WriteString
 00000326  5A		     1	    pop  edx
 00000327			aq_err:
 00000327  F9			    stc
 00000328			aq_done:
 00000328  5E			    pop  esi
 00000329  C3			    ret
 0000032A			AskQuantity ENDP

				; ConfirmYN : lee una respuesta S/N.
				; Salida  : CF=0 si respondio S/s; CF=1 en cualquier otro caso.
				; Modifica: EAX, EFLAGS

 0000032A			ConfirmYN PROC
 0000032A  E8 FFFFFCF4		    call ReadLine
 0000032F  72 12		    jc   cy_no
 00000331  83 F8 01		    cmp  eax, 1
 00000334  75 0D		    jne  cy_no
 00000336  A0 00000609 R	    mov  al, [inbuf]
 0000033B  0C 20		    or   al, 20h                ; a minuscula
 0000033D  3C 73		    cmp  al, 's'
 0000033F  75 02		    jne  cy_no
 00000341  F8			    clc
 00000342  C3			    ret
 00000343			cy_no:
 00000343  F9			    stc
 00000344  C3			    ret
 00000345			ConfirmYN ENDP

				; DoRegister : alta de producto. Todo se valida y se guarda en variables
				;              temporales; el catalogo solo cambia al final (sin cambios
				;              parciales).
				; Modifica: EAX, EBX, ECX, EDX, ESI, EDI, EFLAGS


 00000345			DoRegister PROC
 00000345  83 3D 00000000 R	    cmp  prodCount, PROD_MAX
	   0A
 0000034C  72 0D		    jb   dr_space
				    Say  msgFull
 0000034E  52		     1	    push edx
 0000034F  BA 000011D9 R     1	    mov  edx, OFFSET msgFull
 00000354  E8 00000000 E     1	    call WriteString
 00000359  5A		     1	    pop  edx
 0000035A  C3			    ret
 0000035B			dr_space:
				    Say  msgAskCode
 0000035B  52		     1	    push edx
 0000035C  BA 00001016 R     1	    mov  edx, OFFSET msgAskCode
 00000361  E8 00000000 E     1	    call WriteString
 00000366  5A		     1	    pop  edx
 00000367  E8 FFFFFCED		    call GetInput
 0000036C  0F 82 00000167	    jc   dr_end
 00000372  BE 00000609 R	    mov  esi, OFFSET inbuf
 00000377  E8 FFFFFE39		    call ValidateCode
 0000037C  0F 82 00000117	    jc   dr_badcode
 00000382  BF 00000609 R	    mov  edi, OFFSET inbuf
 00000387  E8 FFFFFEAA		    call FindProduct
 0000038C  0F 83 00000114	    jnc  dr_dup
 00000392  BE 00000609 R	    mov  esi, OFFSET inbuf
 00000397  BF 00000689 R	    mov  edi, OFFSET tmpCode
 0000039C  B9 00000008		    mov  ecx, CODE_SIZE
 000003A1  E8 FFFFFC5A		    call CopyPad
				    Say  msgAskName
 000003A6  52		     1	    push edx
 000003A7  BA 00001029 R     1	    mov  edx, OFFSET msgAskName
 000003AC  E8 00000000 E     1	    call WriteString
 000003B1  5A		     1	    pop  edx
 000003B2  E8 FFFFFCA2		    call GetInput
 000003B7  0F 82 0000011C	    jc   dr_end
 000003BD  BE 00000609 R	    mov  esi, OFFSET inbuf
 000003C2  E8 FFFFFE29		    call ValidateName
 000003C7  0F 82 000000E6	    jc   dr_badname
 000003CD  BF 00000691 R	    mov  edi, OFFSET tmpName
 000003D2  B9 0000001A		    mov  ecx, NAME_SIZE
 000003D7  E8 FFFFFC24		    call CopyPad
				    Say  msgAskPrice
 000003DC  52		     1	    push edx
 000003DD  BA 00001046 R     1	    mov  edx, OFFSET msgAskPrice
 000003E2  E8 00000000 E     1	    call WriteString
 000003E7  5A		     1	    pop  edx
 000003E8  E8 FFFFFC6C		    call GetInput
 000003ED  0F 82 000000E6	    jc   dr_end
 000003F3  BE 00000609 R	    mov  esi, OFFSET inbuf
 000003F8  E8 FFFFFCB1		    call ParsePrice
 000003FD  0F 82 000000BD	    jc   dr_badprice
 00000403  A3 000006AB R	    mov  tmpPrice, eax
				    Say  msgAskStock
 00000408  52		     1	    push edx
 00000409  BA 00001063 R     1	    mov  edx, OFFSET msgAskStock
 0000040E  E8 00000000 E     1	    call WriteString
 00000413  5A		     1	    pop  edx
 00000414  E8 FFFFFC40		    call GetInput
 00000419  0F 82 000000BA	    jc   dr_end
 0000041F  BE 00000609 R	    mov  esi, OFFSET inbuf
 00000424  E8 FFFFFC4B		    call ParseUInt
 00000429  0F 82 0000009E	    jc   dr_badstock
 0000042F  83 F8 64		    cmp  eax, MAX_STOCK
 00000432  0F 87 00000095	    ja   dr_badstock
 00000438  A3 000006AF R	    mov  tmpStock, eax
				    ;  confirmacion: se escribe el registro en la tabla 
 0000043D  A1 00000000 R	    mov  eax, prodCount
 00000442  6B C0 2C		    imul eax, eax, REC_SIZE
 00000445  BB 00000004 R	    mov  ebx, OFFSET products
 0000044A  03 D8		    add  ebx, eax               ; EBX = registro destino
 0000044C  BE 00000689 R	    mov  esi, OFFSET tmpCode
 00000451  8B FB		    mov  edi, ebx
 00000453  B9 00000008		    mov  ecx, CODE_SIZE
 00000458  E8 FFFFFBA3		    call CopyPad
 0000045D  BE 00000691 R	    mov  esi, OFFSET tmpName
 00000462  8D 7B 08		    lea  edi, [ebx+OFF_NAME]
 00000465  B9 0000001A		    mov  ecx, NAME_SIZE
 0000046A  E8 FFFFFB91		    call CopyPad
 0000046F  A1 000006AB R	    mov  eax, tmpPrice
