				; ============================================================================
				; CalcDiscount : regla de descuento por cantidad.
				;   descuento = base*10/100 si cantidad>=10 (division entera: se descarta la
				;               fraccion de centavo); 0 en otro caso.
				; Entrada : EAX = importe base, EBX = cantidad.
				; Salida  : EAX = descuento; CF=1 si desborda.
				; Modifica: EAX, EFLAGS
				; ============================================================================
 000005FA			CalcDiscount PROC USES ebx edx      ; EAX es resultado -> fuera de USES
 000005FA  53		   *	    push   ebx
 000005FB  52		   *	    push   edx
 000005FC  83 FB 0A		    cmp  ebx, DISC_MIN_QTY
 000005FF  72 14		    jb   cd_none
 00000601  BB 0000000A		    mov  ebx, DISC_PCT
 00000606  F7 E3		    mul  ebx                    ; EDX:EAX = base*10 ; CF=1 si desborda
 00000608  72 0D		    jc   cd_end
 0000060A  BB 00000064		    mov  ebx, 100
 0000060F  F7 F3		    div  ebx                    ; descuento entero (EDX=0 tras MUL sin acarreo)
 00000611  F8			    clc
				    ret
 00000612  5A		   *	    pop    edx
 00000613  5B		   *	    pop    ebx
 00000614  C3		   *	    ret    00000h
 00000615			cd_none:
 00000615  33 C0		    xor  eax, eax               ; descuento 0 y CF=0
 00000617			cd_end:
				    ret
 00000617  5A		   *	    pop    edx
 00000618  5B		   *	    pop    ebx
 00000619  C3		   *	    ret    00000h
 0000061A			CalcDiscount ENDP

				; ============================================================================
				; CalcSale : base = precio*cantidad; descuento; final = base - descuento.
				; Entrada : ESI = registro del producto, EBX = cantidad.
				; Salida  : ECX = base, EDI = descuento, EDX = final; CF=1 si desborda.
				; Modifica: ECX, EDX, EDI, EFLAGS
				; ============================================================================
 0000061A			CalcSale PROC USES eax              ; ECX, EDX, EDI son resultados
 0000061A  50		   *	    push   eax
 0000061B  8B 46 24		    mov  eax, [esi+OFF_PRICE]
 0000061E  F7 E3		    mul  ebx                    ; EDX:EAX = precio*cantidad
 00000620  72 10		    jc   cs_end
 00000622  8B C8		    mov  ecx, eax               ; ECX = importe base
 00000624  E8 FFFFFFD1		    call CalcDiscount           ; EAX = base -> EAX = descuento
 00000629  72 07		    jc   cs_end
 0000062B  8B F8		    mov  edi, eax               ; EDI = descuento
 0000062D  8B D1		    mov  edx, ecx
 0000062F  2B D7		    sub  edx, edi               ; EDX = importe final
 00000631  F8			    clc
 00000632			cs_end:
				    ret
 00000632  58		   *	    pop    eax
 00000633  C3		   *	    ret    00000h
 00000634			CalcSale ENDP

				; ============================================================================
				; DoSell : venta de un solo producto con descuento por cantidad.
				; Existencias e ingresos se modifican SOLO despues de pasar todas las pruebas.
				; Modifica: EAX, EBX, ECX, EDX, ESI, EDI, EFLAGS
				; ============================================================================
 00000634			DoSell PROC
 00000634  E8 FFFFFCC6		    call AskProduct
 00000639  0F 82 000000C7	    jc   sl_end
 0000063F  E8 FFFFFC6E		    call ShowRecord
 00000644  E8 FFFFFD0B		    call AskQuantity
 00000649  0F 82 000000B7	    jc   sl_end
 0000064F  8B D8		    mov  ebx, eax               ; EBX = cantidad
 00000651  3B 5E 28		    cmp  ebx, [esi+OFF_STOCK]
