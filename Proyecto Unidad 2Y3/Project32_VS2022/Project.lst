 00000000			.code

				; ============================================================================
				; CopyPad : copia una cadena a un campo de tamano fijo y rellena con 0.
				; Entrada : ESI = origen (cadena terminada en 0), EDI = destino, ECX = tamano
				;           del campo (incluye el 0 final).
				; Salida  : campo con a lo mas ECX-1 caracteres + ceros.
				; Modifica: EFLAGS
				; ============================================================================
 00000000			CopyPad PROC USES eax ecx esi edi
 00000000  50		   *	    push   eax
 00000001  51		   *	    push   ecx
 00000002  56		   *	    push   esi
 00000003  57		   *	    push   edi
 00000004  49			    dec  ecx                    ; reserva el byte del terminador
 00000005			cp_loop:
 00000005  85 C9		    test ecx, ecx
 00000007  74 0D		    jz   cp_fin
 00000009  8A 06		    mov  al, [esi]
 0000000B  84 C0		    test al, al
 0000000D  74 07		    jz   cp_fin
 0000000F  88 07		    mov  [edi], al
 00000011  46			    inc  esi
 00000012  47			    inc  edi
 00000013  49			    dec  ecx
 00000014  EB EF		    jmp  cp_loop
 00000016			cp_fin:
 00000016  41			    inc  ecx                    ; bytes restantes (>=1) a poner en cero
 00000017			cp_zero:
 00000017  C6 07 00		    mov  BYTE PTR [edi], 0
 0000001A  47			    inc  edi
 0000001B  49			    dec  ecx
 0000001C  75 F9		    jnz  cp_zero
				    ret
 0000001E  5F		   *	    pop    edi
 0000001F  5E		   *	    pop    esi
 00000020  59		   *	    pop    ecx
 00000021  58		   *	    pop    eax
 00000022  C3		   *	    ret    00000h
 00000023			CopyPad ENDP

				; ============================================================================
				; ZeroMem : pone en cero un bloque de memoria.
				; Entrada : EDI = inicio, ECX = numero de bytes.
				; Modifica: EFLAGS
				; ============================================================================
 00000023			ZeroMem PROC USES eax ecx edi
 00000023  50		   *	    push   eax
 00000024  51		   *	    push   ecx
 00000025  57		   *	    push   edi
 00000026  FC			    cld
 00000027  32 C0		    xor  al, al
 00000029  F3/ AA		    rep  stosb
				    ret
 0000002B  5F		   *	    pop    edi
 0000002C  59		   *	    pop    ecx
 0000002D  58		   *	    pop    eax
 0000002E  C3		   *	    ret    00000h
 0000002F			ZeroMem ENDP

				; ============================================================================
				; ReadLine : captura una linea en inbuf con ReadString.
				; Salida  : EAX = caracteres leidos; CF=1 si la linea era demasiado larga
				;           (el resto se descarta leyendo hasta vaciar la linea).
				; Modifica: EAX, EFLAGS
				; ============================================================================
 0000002F			ReadLine PROC USES edx ecx
 0000002F  52		   *	    push   edx
 00000030  51		   *	    push   ecx
 00000031  BA 000001C9 R	    mov  edx, OFFSET inbuf
 00000036  B9 0000003F		    mov  ecx, INBUF_MAX         ; max de caracteres (buffer = ECX+1 bytes)
 0000003B  E8 00000000 E	    call ReadString             ; EAX = numero de caracteres capturados
 00000040  83 F8 3F		    cmp  eax, INBUF_MAX
 00000043  72 1C		    jb   rl_ok
 00000045			rl_drain:
 00000045  BA 00000209 R	    mov  edx, OFFSET junkbuf
 0000004A  B9 0000003F		    mov  ecx, INBUF_MAX
 0000004F  E8 00000000 E	    call ReadString
 00000054  83 F8 3F		    cmp  eax, INBUF_MAX
 00000057  73 EC		    jae  rl_drain
 00000059  B8 0000003F		    mov  eax, INBUF_MAX
 0000005E  F9			    stc
 0000005F  EB 01		    jmp  rl_done
 00000061			rl_ok:
 00000061  F8			    clc
 00000062			rl_done:
				    ret
 00000062  59		   *	    pop    ecx
 00000063  5A		   *	    pop    edx
 00000064  C3		   *	    ret    00000h
 00000065			ReadLine ENDP

				; ============================================================================
				; GetInput : ReadLine + rechazo de entrada vacia o demasiado larga.
				; Salida  : EAX = longitud; CF=1 si hay error (ya muestra el mensaje).
				; Modifica: EAX, EFLAGS
				; ============================================================================
 00000065			GetInput PROC
 00000065  E8 FFFFFFC5		    call ReadLine
 0000006A  72 04		    jc   gi_bad
 0000006C  85 C0		    test eax, eax
 0000006E  75 0E		    jnz  gi_ok
 00000070			gi_bad:
				    Fail msgBadInput
 00000070  52		     2	    push edx
 00000071  BA 0000055F R     2	    mov  edx, OFFSET msgBadInput
 00000076  E8 00000000 E     2	    call WriteString
 0000007B  5A		     2	    pop  edx
 0000007C  F9		     1	    stc
 0000007D  C3		     1	    ret
 0000007E			gi_ok:
 0000007E  F8			    clc
 0000007F  C3			    ret
 00000080			GetInput ENDP

				; ============================================================================
				; ParseUInt : cadena de digitos -> entero sin signo (solo '0'..'9').
				; Entrada : ESI = cadena terminada en 0.
				; Salida  : EAX = valor; CF=1 si vacia, con caracteres no permitidos o si
				;           desborda 32 bits.
				; Modifica: EAX, EFLAGS (ESI se conserva)
				; ============================================================================
 00000080			ParseUInt PROC USES ebx ecx edx esi
 00000080  53		   *	    push   ebx
 00000081  51		   *	    push   ecx
 00000082  52		   *	    push   edx
 00000083  56		   *	    push   esi
 00000084  33 C0		    xor  eax, eax
 00000086  33 C9		    xor  ecx, ecx               ; contador de digitos
 00000088			pu_loop:
 00000088  0F B6 1E		    movzx ebx, BYTE PTR [esi]
 0000008B  84 DB		    test bl, bl
 0000008D  74 1E		    jz   pu_end
				    JNotDigit bl, pu_bad
 0000008F  80 FB 30	     2	    cmp  bl, '0'
 00000092  72 20	     2	    jb   pu_bad
 00000094  80 FB 39	     2	    cmp  bl, '9'
 00000097  77 1B	     2	    ja   pu_bad
 00000099  83 EB 30		    sub  ebx, '0'
 0000009C  BA 0000000A		    mov  edx, 10
 000000A1  F7 E2		    mul  edx                    ; EDX:EAX = EAX*10 ; CF=1 si EDX<>0
 000000A3  72 0F		    jc   pu_bad
 000000A5  03 C3		    add  eax, ebx
 000000A7  72 0B		    jc   pu_bad
 000000A9  46			    inc  esi
 000000AA  41			    inc  ecx
 000000AB  EB DB		    jmp  pu_loop
 000000AD			pu_end:
 000000AD  85 C9		    test ecx, ecx
 000000AF  74 03		    jz   pu_bad
 000000B1  F8			    clc
 000000B2  EB 01		    jmp  pu_done
 000000B4			pu_bad:
 000000B4  F9			    stc
 000000B5			pu_done:
				    ret
 000000B5  5E		   *	    pop    esi
 000000B6  5A		   *	    pop    edx
 000000B7  59		   *	    pop    ecx
 000000B8  5B		   *	    pop    ebx
 000000B9  C3		   *	    ret    00000h
 000000BA			ParseUInt ENDP

				; ============================================================================
				; ParseRange : ParseUInt + comprobacion de rango [EDX..ECX].
				; Entrada : ESI = cadena, EDX = minimo, ECX = maximo.
				; Salida  : EAX = valor; CF=1 si es invalido o esta fuera de rango.
				; Modifica: EAX, EFLAGS
				; ============================================================================
 000000BA			ParseRange PROC
 000000BA  E8 FFFFFFC1		    call ParseUInt
 000000BF  72 0B		    jc   pr_end
 000000C1  3B C2		    cmp  eax, edx
 000000C3  72 06		    jb   pr_bad
 000000C5  3B C1		    cmp  eax, ecx
 000000C7  77 02		    ja   pr_bad
 000000C9  F8			    clc
 000000CA  C3			    ret
 000000CB			pr_bad:
 000000CB  F9			    stc
 000000CC			pr_end:
 000000CC  C3			    ret
 000000CD			ParseRange ENDP

				; ============================================================================
				; ParsePrice : "185.50" -> 18550 centavos. Acepta enteros o punto con 1 o 2
				;              decimales. Rechaza simbolos, separadores de miles, ".5", "5.",
				;              tercer decimal y fuera de rango (1..999999 centavos).
				; Entrada : ESI = cadena terminada en 0.
				; Salida  : EAX = centavos; CF=1 si es invalida.
				; Modifica: EAX, EFLAGS (ESI se conserva)
				; ============================================================================
 000000CD			ParsePrice PROC USES ebx ecx edx esi
 000000CD  53		   *	    push   ebx
 000000CE  51		   *	    push   ecx
 000000CF  52		   *	    push   edx
 000000D0  56		   *	    push   esi
 000000D1  33 C0		    xor  eax, eax               ; pesos
 000000D3  33 C9		    xor  ecx, ecx               ; digitos enteros
 000000D5			pp_int:
 000000D5  0F B6 16		    movzx edx, BYTE PTR [esi]
 000000D8  84 D2		    test dl, dl
 000000DA  74 22		    jz   pp_intEnd
 000000DC  80 FA 2E		    cmp  dl, '.'
 000000DF  74 1D		    je   pp_intEnd
				    JNotDigit dl, pp_bad
 000000E1  80 FA 30	     2	    cmp  dl, '0'
 000000E4  72 6A	     2	    jb   pp_bad
 000000E6  80 FA 39	     2	    cmp  dl, '9'
 000000E9  77 65	     2	    ja   pp_bad
 000000EB  83 EA 30		    sub  edx, '0'
 000000EE  6B C0 0A		    imul eax, eax, 10
 000000F1  03 C2		    add  eax, edx
 000000F3  3D 0000270F		    cmp  eax, 9999              ; evita desbordar y valida el maximo de pesos
 000000F8  77 56		    ja   pp_bad
 000000FA  46			    inc  esi
 000000FB  41			    inc  ecx
 000000FC  EB D7		    jmp  pp_int
 000000FE			pp_intEnd:
 000000FE  85 C9		    test ecx, ecx               ; al menos un digito antes del punto
 00000100  74 4E		    jz   pp_bad
 00000102  6B D8 64		    imul ebx, eax, 100          ; EBX = pesos*100
 00000105  80 3E 00		    cmp  BYTE PTR [esi], 0
 00000108  74 34		    je   pp_range               ; sin parte decimal
 0000010A  46			    inc  esi                    ; salta el '.'
 0000010B  0F B6 16		    movzx edx, BYTE PTR [esi]   ; primer decimal (obligatorio)
				    JNotDigit dl, pp_bad
 0000010E  80 FA 30	     2	    cmp  dl, '0'
 00000111  72 3D	     2	    jb   pp_bad
 00000113  80 FA 39	     2	    cmp  dl, '9'
 00000116  77 38	     2	    ja   pp_bad
 00000118  83 EA 30		    sub  edx, '0'
 0000011B  6B D2 0A		    imul edx, edx, 10           ; decenas de centavo
 0000011E  03 DA		    add  ebx, edx
 00000120  46			    inc  esi
 00000121  80 3E 00		    cmp  BYTE PTR [esi], 0
 00000124  74 18		    je   pp_range               ; un solo decimal: 185.5 -> 18550
 00000126  0F B6 16		    movzx edx, BYTE PTR [esi]   ; segundo decimal
				    JNotDigit dl, pp_bad
 00000129  80 FA 30	     2	    cmp  dl, '0'
 0000012C  72 22	     2	    jb   pp_bad
 0000012E  80 FA 39	     2	    cmp  dl, '9'
 00000131  77 1D	     2	    ja   pp_bad
 00000133  83 EA 30		    sub  edx, '0'
 00000136  03 DA		    add  ebx, edx
 00000138  46			    inc  esi
 00000139  80 3E 00		    cmp  BYTE PTR [esi], 0      ; un tercer caracter => rechazo
 0000013C  75 12		    jne  pp_bad
 0000013E			pp_range:
 0000013E  83 FB 01		    cmp  ebx, 1
 00000141  72 0D		    jb   pp_bad
 00000143  81 FB 000F423F	    cmp  ebx, MAX_PRICE
 00000149  77 05		    ja   pp_bad
 0000014B  8B C3		    mov  eax, ebx
 0000014D  F8			    clc
 0000014E  EB 01		    jmp  pp_done
 00000150			pp_bad:
 00000150  F9			    stc
 00000151			pp_done:
				    ret
 00000151  5E		   *	    pop    esi
 00000152  5A		   *	    pop    edx
 00000153  59		   *	    pop    ecx
 00000154  5B		   *	    pop    ebx
 00000155  C3		   *	    ret    00000h
 00000156			ParsePrice ENDP

				; ============================================================================
				; ToDecStr : convierte EAX a cadena decimal sin signo en numbuf (division
				;            entre 10). Los digitos salen en orden inverso (residuos), por
				;            eso se escriben desde el final del buffer hacia atras.
				; Entrada : EAX = valor.
				; Salida  : EDX = inicio de la cadena (terminada en 00h).
				; Modifica: EDX, EFLAGS
				; ============================================================================
 00000156			ToDecStr PROC USES eax ebx edi
 00000156  50		   *	    push   eax
 00000157  53		   *	    push   ebx
 00000158  57		   *	    push   edi
 00000159  BF 0000027E R	    mov  edi, OFFSET numbuf + 11
 0000015E  C6 07 00		    mov  BYTE PTR [edi], 0      ; terminador 00h
 00000161  BB 0000000A		    mov  ebx, 10
 00000166			ts_loop:
 00000166  33 D2		    xor  edx, edx               ; dividendo = EDX:EAX
 00000168  F7 F3		    div  ebx                    ; EAX = cociente, EDX = residuo (0..9)
 0000016A  80 C2 30		    add  dl, '0'                ; digito -> ASCII
 0000016D  4F			    dec  edi
 0000016E  88 17		    mov  [edi], dl
 00000170  85 C0		    test eax, eax
 00000172  75 F2		    jnz  ts_loop
 00000174  8B D7		    mov  edx, edi
				    ret
 00000176  5F		   *	    pop    edi
 00000177  5B		   *	    pop    ebx
 00000178  58		   *	    pop    eax
 00000179  C3		   *	    ret    00000h
 0000017A			ToDecStr ENDP

				; ============================================================================
				; PrintU32 : muestra EAX como decimal sin signo.
				; Entrada : EAX = valor.
				; Modifica: EFLAGS
				; ============================================================================
 0000017A			PrintU32 PROC USES edx
 0000017A  52		   *	    push   edx
 0000017B  E8 FFFFFFD6		    call ToDecStr
 00000180  E8 00000000 E	    call WriteString
				    ret
 00000185  5A		   *	    pop    edx
 00000186  C3		   *	    ret    00000h
 00000187			PrintU32 ENDP

				; ============================================================================
				; SplitMXN : separa centavos en pesos y centavos (DIV entre 100).
				; Entrada : EAX = centavos.
				; Salida  : EAX = pesos, EDX = centavos (0..99).
				; Modifica: EAX, EDX, EFLAGS
				; ============================================================================
 00000187			SplitMXN PROC USES ebx
 00000187  53		   *	    push   ebx
 00000188  BB 00000064		    mov  ebx, 100
 0000018D  33 D2		    xor  edx, edx
 0000018F  F7 F3		    div  ebx
				    ret
 00000191  5B		   *	    pop    ebx
 00000192  C3		   *	    ret    00000h
 00000193			SplitMXN ENDP

				; ============================================================================
				; PrintMXN : muestra centavos como "$1234.05 MXN".
				; Entrada : EAX = centavos.
				; Modifica: EFLAGS
				; ============================================================================
 00000193			PrintMXN PROC USES eax edx
				    Say  msgDollar
 00000193  50		   *	    push   eax
 00000194  52		   *	    push   edx
 00000195  52		     1	    push edx
 00000196  BA 00000AED R     1	    mov  edx, OFFSET msgDollar
 0000019B  E8 00000000 E     1	    call WriteString
 000001A0  5A		     1	    pop  edx
 000001A1  E8 FFFFFFE1		    call SplitMXN               ; EAX = pesos, EDX = centavos
 000001A6  52			    push edx                    ; guarda centavos
 000001A7  E8 FFFFFFCE		    call PrintU32               ; pesos
				    Say  msgDot
 000001AC  52		     1	    push edx
 000001AD  BA 00000AEF R     1	    mov  edx, OFFSET msgDot
 000001B2  E8 00000000 E     1	    call WriteString
 000001B7  5A		     1	    pop  edx
 000001B8  58			    pop  eax                    ; centavos
 000001B9  83 F8 0A		    cmp  eax, 10
 000001BC  73 0C		    jae  pm_two
				    Say  msgZero                ; residuo 5 -> "05"
 000001BE  52		     1	    push edx
 000001BF  BA 00000AF1 R     1	    mov  edx, OFFSET msgZero
 000001C4  E8 00000000 E     1	    call WriteString
 000001C9  5A		     1	    pop  edx
 000001CA			pm_two:
 000001CA  E8 FFFFFFAB		    call PrintU32
				    Say  msgMXN
 000001CF  52		     1	    push edx
 000001D0  BA 00000AF3 R     1	    mov  edx, OFFSET msgMXN
 000001D5  E8 00000000 E     1	    call WriteString
 000001DA  5A		     1	    pop  edx
				    ret
 000001DB  5A		   *	    pop    edx
 000001DC  58		   *	    pop    eax
 000001DD  C3		   *	    ret    00000h
 000001DE			PrintMXN ENDP

				; ============================================================================
				; ValidateCode : valida ABC-123 (3 mayusculas, guion, 3 digitos, fin de cadena)
				; Entrada : ESI = cadena.
				; Salida  : CF=1 si es invalida.
				; Modifica: EFLAGS (ESI se conserva)
				; ============================================================================
 000001DE			ValidateCode PROC USES eax ecx esi
 000001DE  50		   *	    push   eax
 000001DF  51		   *	    push   ecx
 000001E0  56		   *	    push   esi
 000001E1  B9 00000003		    mov  ecx, 3
 000001E6			vc_l1:
 000001E6  8A 06		    mov  al, [esi]
				    JNotRange al, 'A', 'Z', vc_bad
 000001E8  3C 41	     1	    cmp  al, 'A'
 000001EA  72 28	     1	    jb   vc_bad
 000001EC  3C 5A	     1	    cmp  al, 'Z'
 000001EE  77 24	     1	    ja   vc_bad
 000001F0  46			    inc  esi
 000001F1  E2 F3		    loop vc_l1
 000001F3  8A 06		    mov  al, [esi]
 000001F5  3C 2D		    cmp  al, '-'
 000001F7  75 1B		    jne  vc_bad
 000001F9  46			    inc  esi
 000001FA  B9 00000003		    mov  ecx, 3
 000001FF			vc_l2:
 000001FF  8A 06		    mov  al, [esi]
				    JNotDigit al, vc_bad
 00000201  3C 30	     2	    cmp  al, '0'
 00000203  72 0F	     2	    jb   vc_bad
 00000205  3C 39	     2	    cmp  al, '9'
 00000207  77 0B	     2	    ja   vc_bad
 00000209  46			    inc  esi
 0000020A  E2 F3		    loop vc_l2
 0000020C  80 3E 00		    cmp  BYTE PTR [esi], 0
 0000020F  75 03		    jne  vc_bad
 00000211  F8			    clc
 00000212  EB 01		    jmp  vc_done
 00000214			vc_bad:
 00000214  F9			    stc
 00000215			vc_done:
				    ret
 00000215  5E		   *	    pop    esi
 00000216  59		   *	    pop    ecx
 00000217  58		   *	    pop    eax
 00000218  C3		   *	    ret    00000h
 00000219			ValidateCode ENDP

				; ============================================================================
				; ValidateName : 1 a 25 caracteres ASCII imprimibles y terminador 0.
				; Entrada : ESI = cadena.
				; Salida  : CF=1 si es invalida.
				; Modifica: EFLAGS (ESI se conserva)
				; ============================================================================
 00000219			ValidateName PROC USES eax ecx esi
 00000219  50		   *	    push   eax
 0000021A  51		   *	    push   ecx
 0000021B  56		   *	    push   esi
 0000021C  33 C9		    xor  ecx, ecx
 0000021E			vn_loop:
 0000021E  8A 06		    mov  al, [esi]
 00000220  84 C0		    test al, al
 00000222  74 11		    jz   vn_end
				    JNotRange al, 32, 126, vn_bad
 00000224  3C 20	     1	    cmp  al, 32
 00000226  72 14	     1	    jb   vn_bad
 00000228  3C 7E	     1	    cmp  al, 126
 0000022A  77 10	     1	    ja   vn_bad
 0000022C  46			    inc  esi
 0000022D  41			    inc  ecx
 0000022E  83 F9 19		    cmp  ecx, 25
 00000231  76 EB		    jbe  vn_loop
 00000233  EB 07		    jmp  vn_bad                 ; mas de 25 caracteres
 00000235			vn_end:
 00000235  85 C9		    test ecx, ecx
 00000237  74 03		    jz   vn_bad                 ; vacio
 00000239  F8			    clc
 0000023A  EB 01		    jmp  vn_done
 0000023C			vn_bad:
 0000023C  F9			    stc
 0000023D			vn_done:
				    ret
 0000023D  5E		   *	    pop    esi
 0000023E  59		   *	    pop    ecx
 0000023F  58		   *	    pop    eax
 00000240  C3		   *	    ret    00000h
 00000241			ValidateName ENDP

				; ============================================================================
				; ValidateRecord : valida un registro completo (codigo, nombre, precio, stock)
				; Entrada : ESI = inicio del registro.
				; Salida  : CF=1 si es invalido.
				; Modifica: EFLAGS (ESI se conserva)
				; ============================================================================
 00000241			ValidateRecord PROC USES eax esi
 00000241  50		   *	    push   eax
 00000242  56		   *	    push   esi
 00000243  E8 FFFFFF96		    call ValidateCode           ; codigo en offset 0
 00000248  72 27		    jc   vr_bad
 0000024A  83 C6 08		    add  esi, OFF_NAME
 0000024D  E8 FFFFFFC7		    call ValidateName
 00000252  72 1D		    jc   vr_bad
 00000254  83 EE 08		    sub  esi, OFF_NAME
 00000257  8B 46 24		    mov  eax, [esi+OFF_PRICE]
 0000025A  83 F8 01		    cmp  eax, 1
 0000025D  72 12		    jb   vr_bad
 0000025F  3D 000F423F		    cmp  eax, MAX_PRICE
 00000264  77 0B		    ja   vr_bad
 00000266  8B 46 28		    mov  eax, [esi+OFF_STOCK]
 00000269  83 F8 64		    cmp  eax, MAX_STOCK
 0000026C  77 03		    ja   vr_bad
 0000026E  F8			    clc
 0000026F  EB 01		    jmp  vr_done
 00000271			vr_bad:
 00000271  F9			    stc
 00000272			vr_done:
				    ret
 00000272  5E		   *	    pop    esi
 00000273  58		   *	    pop    eax
 00000274  C3		   *	    ret    00000h
 00000275			ValidateRecord ENDP

				; ============================================================================
				; CodesEqual : compara los 7 caracteres de dos codigos.
				; Entrada : ESI, EDI = codigos.
				; Salida  : ZF=1 si son iguales.
				; Modifica: EFLAGS
				; ============================================================================
 00000275			CodesEqual PROC USES eax ecx esi edi
 00000275  50		   *	    push   eax
 00000276  51		   *	    push   ecx
 00000277  56		   *	    push   esi
 00000278  57		   *	    push   edi
 00000279  B9 00000007		    mov  ecx, 7
 0000027E			ce_loop:
 0000027E  8A 06		    mov  al, [esi]
 00000280  3A 07		    cmp  al, [edi]
 00000282  75 06		    jne  ce_done                ; ZF=0
 00000284  46			    inc  esi
 00000285  47			    inc  edi
 00000286  E2 F6		    loop ce_loop
 00000288  33 C0		    xor  eax, eax               ; llegaron los 7 iguales: fuerza ZF=1
 0000028A			ce_done:
				    ret                         ; los POP del epilogo no alteran las banderas
 0000028A  5F		   *	    pop    edi
 0000028B  5E		   *	    pop    esi
 0000028C  59		   *	    pop    ecx
 0000028D  58		   *	    pop    eax
 0000028E  C3		   *	    ret    00000h
 0000028F			CodesEqual ENDP

				; ============================================================================
				; FindProduct : busca un codigo en el catalogo (recorrido con ESI).
				; Entrada : EDI = codigo (cadena).
				; Salida  : CF=0 y ESI = registro encontrado; CF=1 si no existe.
				; Modifica: ESI, EFLAGS
				; ============================================================================
 0000028F			FindProduct PROC USES ecx
 0000028F  51		   *	    push   ecx
 00000290  BE 00000008 R	    mov  esi, OFFSET products
 00000295  8B 0D 00000004 R	    mov  ecx, prodCount
 0000029B  85 C9		    test ecx, ecx
 0000029D  74 0D		    jz   fp_nf
 0000029F			fp_loop:
 0000029F  E8 FFFFFFD1		    call CodesEqual
 000002A4  74 09		    je   fp_found
 000002A6  83 C6 2C		    add  esi, REC_SIZE
 000002A9  49			    dec  ecx
 000002AA  75 F3		    jnz  fp_loop
 000002AC			fp_nf:
 000002AC  F9			    stc
				    ret
 000002AD  59		   *	    pop    ecx
